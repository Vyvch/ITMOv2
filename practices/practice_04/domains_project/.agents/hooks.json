{
  "run-tests-after-edit": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ../scripts/hook_runner.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
