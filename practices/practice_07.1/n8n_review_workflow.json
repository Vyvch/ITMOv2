    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты — независимый эксперт по архитектуре и надёжности Python (Вторая модель: DeepSeek).\nСделай альтернативное ТОЧЕЧНОЕ код-ревью изменённых строк.\nКаждая строка снабжена `<файл>:<номер_строки> | +<код>`.\n\nНайди проблемы надёжности, масштабируемости, проверь валидацию типов и краевые условия.\n\nВЕРНИ ТОЛЬКО валидный JSON (без разметки вокруг):\n{\n  \"summary\": \"### 🔬 Alternative AI Code Review (Вторая модель: DeepSeek)\\n\\nАльтернативный вердикт по архитектуре и безопасности.\",\n  \"comments\": [\n    {\n      \"path\": \"analyzer.py\",\n      \"line\": 35,\n      \"side\": \"RIGHT\",\n      \"body\": \"🔬 Точечное замечание от DeepSeek: обратите внимание на...\"\n    }\n  ]\n}\n\nИзменения:\n{{ $json.formatted_diff }}",
        "options": {
          "systemMessage": "Ты возвращаешь исключительно валидный JSON."
        }
      },
      "id": "agent-secondary",
      "name": "Secondary Inline Reviewer (DeepSeek)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        1920,
        240
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "deepseek/deepseek-chat",
          "mode": "list",
          "cachedResultName": "deepseek/deepseek-chat"
        },
        "options": {}
      },
      "id": "secondary-model",
      "name": "Model 2 (DeepSeek-Chat)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1920,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst agentOutput = $json.output || $json.text || '';\nconst parsedData = $('Parse Diff & Number Lines').first().json;\nconst commitId = parsedData.commit_id;\n\nlet parsed = { summary: 'AI Code Review', comments: [] };\ntry {\n  let clean = agentOutput.replace(/```json/gi, '').replace(/```/g, '').trim();\n  const firstBrace = clean.indexOf('{');\n  const lastBrace = clean.lastIndexOf('}');\n  if (firstBrace !== -1 && lastBrace !== -1) {\n    clean = clean.substring(firstBrace, lastBrace + 1);\n  }\n  parsed = JSON.parse(clean);\n} catch (e) {\n  parsed = { summary: agentOutput, comments: [] };\n}\n\nconst safeComments = (parsed.comments || []).map(c => ({\n  path: c.path,\n  line: parseInt(c.line, 10),\n  side: c.side || 'RIGHT',\n  body: c.body\n})).filter(c => c.path && !isNaN(c.line) && c.body);\n\nreturn {\n  json: {\n    commit_id: commitId,\n    body: parsed.summary || '### 🤖 AI Code Review (Точечные замечания)',\n    event: 'COMMENT',\n    comments: safeComments\n  }\n};\n"
      },
