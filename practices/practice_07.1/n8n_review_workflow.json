      "id": "get-pr-diff",
      "name": "Get PR Diff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst diffText = $json.data || '';\nconst prDetails = $('Get PR Details (head.sha)').first().json;\nconst headSha = prDetails.head ? prDetails.head.sha : '';\nconst prNumber = prDetails.number;\nconst repoFullName = prDetails.base.repo.full_name;\n\nconst lines = diffText.split('\\n');\nlet currentFile = null;\nlet newLineNum = 0;\nconst formatted = [];\nconst validLines = [];\n\nfor (const line of lines) {\n  if (line.startsWith('diff --git')) {\n    const match = line.match(/b\\/(.+)$/);\n    currentFile = match ? match[1].trim() : null;\n  } else if (line.startsWith('@@')) {\n    const hunkMatch = line.match(/\\+([0-9]+)(?:,([0-9]+))?/);\n    if (hunkMatch) newLineNum = parseInt(hunkMatch[1], 10);\n    formatted.push(`\\n--- Файл: ${currentFile} ---`);\n  } else if (currentFile && newLineNum > 0) {\n    if (line.startsWith('+') && !line.startsWith('+++')) {\n      formatted.push(`${currentFile}:${newLineNum} | ${line}`);\n      validLines.push({ path: currentFile, line: newLineNum });\n      newLineNum++;\n    } else if (line.startsWith('-') && !line.startsWith('---')) {\n    } else {\n      formatted.push(`${currentFile}:${newLineNum} |   ${line}`);\n      newLineNum++;\n    }\n  }\n}\n\nreturn {\n  json: {\n    formatted_diff: formatted.join('\\n'),\n    commit_id: headSha,\n    pr_number: prNumber,\n    repo: repoFullName\n  }\n};\n"
      },
      "id": "parse-diff-node",
