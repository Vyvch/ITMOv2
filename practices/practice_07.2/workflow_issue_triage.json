{
  "name": "Practice 7.2 - Issue Triage Main Workflow",
  "nodes": [
    {
      "parameters": {
        "owner": {
          "__rl": true,
          "value": "Vyvch",
          "mode": "list",
          "cachedResultName": "Vyvch"
        },
        "repository": {
          "__rl": true,
          "value": "drop_ru_domain_finder",
          "mode": "list",
          "cachedResultName": "drop_ru_domain_finder"
        },
        "events": [
          "issues"
        ],
        "options": {}
      },
      "id": "github-issue-trigger",
      "name": "GitHub Issues Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [
        200,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "opened",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "filter-opened-action",
      "name": "Action == opened?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        360
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "Practice 7.2 - Issue Classifier (Sub-workflow)",
          "mode": "name"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "title": "={{ $('GitHub Issues Trigger').first().json.body.issue.title }}",
            "body": "={{ $('GitHub Issues Trigger').first().json.body.issue.body || '' }}"
          }
        },
        "options": {}
      },
      "id": "call-classifier-subworkflow",
      "name": "Call Classifier Sub-workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        680,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "leftValue": "={{ Number($json.confidence) }}",
              "rightValue": 0.8,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "leftValue": "={{ $json.type }}",
              "rightValue": "unknown",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-confidence-escalation",
      "name": "Confidence >= 0.8?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        920,
        360
      ]
    },
    {
      "parameters": {
        "operation": "edit",
