    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты — старший инженер-архитектор.\nНа основе заголовка и описания бага определи, в каком именно Python-файле репозитория находится ошибка.\n\nБАГ-РЕПОРТ #{{ $('Extract Dynamic Issue Data').first().json.issue_number }}:\nЗаголовок: {{ $('Extract Dynamic Issue Data').first().json.issue_title }}\nОписание: {{ $('Extract Dynamic Issue Data').first().json.issue_body }}\n\nСПИСОК ФАЙЛОВ РЕПОЗИТОРИЯ:\n{{ $json.tree.filter(item => item.path.endsWith('.py') && !item.path.startsWith('tests/')).map(item => item.path).join('\\n') }}\n\nВерни ТОЛЬКО имя файла (например: domain_exporter.py или services.py). Без каких-либо лишних слов, без кавычек и без форматирования."
      },
      "id": "ai-locate-file",
      "name": "AI File Locator (LLM)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1100,
        360
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "openai/gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "openai/gpt-4o-mini"
        },
        "options": {}
      },
      "id": "ai-model-locator",
      "name": "OpenAI Chat Model (Locator)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1100,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "\nlet targetFile = ($json.text || $json.output || '').trim();\ntargetFile = targetFile.replace(/[`'\"\\n]/g, '').trim();\nif (!targetFile.endsWith('.py')) {\n  targetFile = 'domain_exporter.py'; // безопасный фоллбэк\n}\n\nreturn {\n  json: {\n    target_file: targetFile\n  }\n};\n"
      },
      "id": "clean-target-filename",
      "name": "Clean Target Filename",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        360
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/Vyvch/drop_ru_domain_finder/contents/{{ $json.target_file }}?ref=main",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "fetch-source-file",
      "name": "Fetch Target Source File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        360
      ]
