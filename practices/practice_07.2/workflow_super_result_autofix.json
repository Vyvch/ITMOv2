    {
      "parameters": {
        "jsCode": "\nconst contentB64 = $json.content || '';\nconst rawCode = Buffer.from(contentB64.replace(/\\n/g, ''), 'base64').toString('utf-8');\nconst meta = $('Extract Dynamic Issue Data').first().json;\nconst file = $('Clean Target Filename').first().json.target_file;\n\nreturn {\n  json: {\n    original_code: rawCode,\n    file_sha: $json.sha,\n    target_file: file,\n    issue_number: meta.issue_number,\n    issue_title: meta.issue_title,\n    issue_body: meta.issue_body,\n    branch_name: meta.branch_name,\n    attempt: 1,\n    max_attempts: 3,\n    critique: '',\n    verdict: 'PENDING'\n  }\n};\n"
      },
      "id": "init-loop-state",
      "name": "Init Self-Correction State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        360
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты — Senior Python Developer (Генератор фикса).\nИсправь ошибку в коде файла {{ $json.target_file }} на основе баг-репорта.\n\nБАГ-РЕПОРТ #{{ $json.issue_number }}:\n{{ $json.issue_title }}\n{{ $json.issue_body }}\n\nИСХОДНЫЙ КОД:\n{{ $json.original_code }}\n\n{{ $json.critique ? 'ВНИМАНИЕ! Предыдущая попытка была отклонена AI-Судьёй с замечаниями:\\n' + $json.critique + '\\nОбязательно исправь код с учётом этой критики!\\n' : '' }}\n\nВерни ТОЛЬКО полный исправленный Python-код файла целиком. Без каких-либо пояснений, без markdown-разметки (без обратных кавычек ```python)."
      },
      "id": "ai-code-fixer-actor",
      "name": "AI Code Fixer (Generator)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        2020,
        360
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "openai/gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "openai/gpt-4o-mini"
        },
        "options": {}
      },
      "id": "ai-model-actor",
      "name": "OpenAI Chat Model (Actor)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        2020,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "\nlet fixedText = $json.text || $json.output || '';\nfixedText = fixedText.replace(/```python/gi, '').replace(/```/g, '').trim();\n\nconst state = $('Init Self-Correction State').first().json;\n\nreturn {\n  json: {\n    ...state,\n    candidate_code: fixedText\n  }\n};\n"
      },
      "id": "format-candidate-code",
      "name": "Format Candidate Fix",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        360
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты — строгий Principal Code Reviewer & AI-Судья (Critic / Evaluator).\nТвоя задача — беспристрастно и строго проверить предложенное исправление бага.\n\nБАГ-РЕПОРТ #{{ $json.issue_number }}:\n{{ $json.issue_title }}\n{{ $json.issue_body }}\n\nПРЕДЛОЖЕННЫЙ ПАТЧ ДЛЯ ФАЙЛА {{ $json.target_file }}:\n{{ $json.candidate_code }}\n\nКРИТЕРИИ ОЦЕНКИ:\n1. Исправляет ли патч указанную ошибку (например, проверяет пустой список доменов для предотвращения ZeroDivisionError)?\n2. Сохранена ли корректная сигнатура функции, типизация и возвращаемые значения?\n3. Нет ли синтаксических ошибок, регрессий или удалённого нужного кода?\n\nФОРМАТ ОТВЕТА (строго JSON):\n{\n  \"verdict\": \"APPROVED\" или \"REJECTED\",\n  \"reason\": \"Если REJECTED — подробно опиши, что именно не так и как это переделать. Если APPROVED — кратко подтверди корректность\",\n  \"confidence\": 0.95\n}"
      },
      "id": "ai-judge-critic",
      "name": "AI Judge (Critic / Reviewer)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        2480,
        360
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "openai/gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "openai/gpt-4o-mini"
        },
        "options": {}
      },
      "id": "ai-model-critic",
      "name": "OpenAI Chat Model (Critic)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        2480,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "\nlet raw = $json.text || $json.output || '';\nlet parsed = {};\n\ntry {\n  let clean = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n  const first = clean.indexOf('{');\n  const last = clean.lastIndexOf('}');\n  if (first !== -1 && last !== -1) {\n    clean = clean.substring(first, last + 1);\n  }\n  parsed = JSON.parse(clean);\n} catch (e) {\n  parsed = { verdict: 'APPROVED', reason: 'Auto-approved fallback' };\n}\n\nconst verdict = (parsed.verdict || 'REJECTED').toUpperCase().trim();\nconst isApproved = verdict === 'APPROVED';\nconst candidate = $('Format Candidate Fix').first().json;\n\nreturn {\n  json: {\n    ...candidate,\n    verdict: verdict,\n    critique: parsed.reason || '',\n    is_approved: isApproved,\n    attempt: candidate.attempt + 1\n  }\n};\n"
      },
      "id": "evaluate-judge-verdict",
      "name": "Evaluate Judge Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
