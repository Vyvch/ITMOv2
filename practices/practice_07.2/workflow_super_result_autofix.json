    {
      "parameters": {
        "jsCode": "\nconst contentB64 = $json.content || '';\nconst rawCode = Buffer.from(contentB64.replace(/\\n/g, ''), 'base64').toString('utf-8');\n\nreturn {\n  json: {\n    code: rawCode,\n    file_sha: $json.sha,\n    target_file: $('Clean Target Filename').first().json.target_file\n  }\n};\n"
      },
      "id": "decode-source-code",
      "name": "Decode Source Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        360
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Ты — Senior Python Developer.\nИсправь баг в файле {{ $json.target_file }} на основе баг-репорта.\n\nБАГ-РЕПОРТ #{{ $('Extract Dynamic Issue Data').first().json.issue_number }}:\n{{ $('Extract Dynamic Issue Data').first().json.issue_title }}\n{{ $('Extract Dynamic Issue Data').first().json.issue_body }}\n\nТЕКУЩИЙ ИСХОДНЫЙ КОД:\n{{ $json.code }}\n\nЗАДАЧА:\nВнеси аккуратный, точный фикс. Устрани описанную ошибку (например, ZeroDivisionError или граничный случай).\nВерни ТОЛЬКО полный исправленный Python-код файла целиком. Без пояснений, без markdown-тегов (без обратных кавычек ```python)."
      },
      "id": "ai-code-fixer",
      "name": "AI Code Fixer (LLM)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
