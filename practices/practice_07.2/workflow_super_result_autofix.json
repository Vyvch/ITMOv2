    {
      "parameters": {
        "jsCode": "\nlet fixedText = $json.text || $json.output || '';\nfixedText = fixedText.replace(/```python/gi, '').replace(/```/g, '').trim();\n\nconst fixedB64 = Buffer.from(fixedText, 'utf-8').toString('base64');\nconst meta = $('Extract Dynamic Issue Data').first().json;\nconst fileMeta = $('Decode Source Code').first().json;\n\nreturn {\n  json: {\n    fixed_content_b64: fixedB64,\n    original_sha: fileMeta.file_sha,\n    target_file: fileMeta.target_file,\n    issue_number: meta.issue_number,\n    issue_title: meta.issue_title,\n    branch_name: meta.branch_name\n  }\n};\n"
      },
