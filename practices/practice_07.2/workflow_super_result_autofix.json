    {
      "parameters": {
        "jsCode": "\nconst body = $('GitHub Issues Trigger').first().json.body;\nconst issue = body.issue || body;\n\nreturn {\n  json: {\n    issue_number: issue.number,\n    issue_title: issue.title,\n    issue_body: issue.body || '',\n    branch_name: `fix/issue-${issue.number}-autofix`\n  }\n};\n"
      },
